# Copy to .env for local development. Never commit .env.
# In production these are set as Railway environment variables.

# Built frontend that FastAPI serves (output of `npm run build`).
STATIC_DIR=dist

# Most people allowed in one game room (pétanque doubles = 4).
MAX_ROOM_MEMBERS=4

# Rooms held in memory at once; protects a small server from runaway creation.
MAX_ROOMS=500

# Largest single WebSocket message, in bytes.
MAX_MESSAGE_BYTES=16384
